---
import { nav, contact } from '../data/site.js';
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a href="/" class="brand" aria-label="ValidThèse, accueil">
      <img src="/logo-cb.svg" alt="" width="34" height="38" />
      <span class="brand__txt">
        <span class="brand__name">Valid<span>Thèse</span></span>
        <span class="brand__by">par CEBI Stats</span>
      </span>
    </a>

    <nav class="nav" id="nav" aria-label="Navigation principale">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li class="nav__ext"><a href={contact.cebistats} target="_blank" rel="noopener">CEBI Stats</a></li>
      </ul>
      <a href="#contact" class="btn btn--primary nav__cta">Présenter ma thèse</a>
    </nav>

    <button class="burger" aria-expanded="false" aria-controls="nav" aria-label="Ouvrir le menu">
      <span></span><span></span>
    </button>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.burger')!;
  const hdr = document.querySelector('.hdr')!;
  const setOpen = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    hdr.classList.toggle('is-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  };
  btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  hdr.querySelectorAll('.nav a[href^="#"]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  const onScroll = () => hdr.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: rgba(245, 247, 248, .92); backdrop-filter: blur(12px); border-bottom: 1px solid transparent; transition: border-color .2s; }
  .hdr.is-scrolled { border-bottom-color: var(--line); }
  .hdr__in { display: flex; align-items: center; gap: 24px; height: 72px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; flex: none; }
  .brand img { width: 34px; height: auto; }
  .brand__txt { display: grid; line-height: 1; }
  .brand__name { font-family: var(--display); font-stretch: 112%; font-weight: 800; font-size: 1.32rem; letter-spacing: -.02em; color: var(--navy); }
  .brand__name span { color: var(--teal-700); }
  .brand__by { font-size: .74rem; font-weight: 600; color: var(--muted); margin-top: 4px; }

  .nav { margin-left: auto; display: flex; align-items: center; gap: 18px; }
  .nav ul { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .nav ul a { display: block; white-space: nowrap; padding: 8px 11px; text-decoration: none; color: var(--text); font-weight: 500; font-size: .95rem; }
  .nav ul a:hover { color: var(--navy); }
  .nav__ext a { color: var(--muted) !important; }
  .nav__ext a::after { content: ' ↗'; }
  .nav__cta { padding: 11px 18px; font-size: .93rem; }

  .burger { display: none; margin-left: auto; width: 44px; height: 44px; border: 0; background: none; cursor: pointer; position: relative; }
  .burger span { position: absolute; left: 10px; right: 10px; height: 2px; background: var(--ink); transition: transform .25s, top .25s; }
  .burger span:first-child { top: 17px; }
  .burger span:last-child { top: 25px; }
  .is-open .burger span:first-child { top: 21px; transform: rotate(45deg); }
  .is-open .burger span:last-child { top: 21px; transform: rotate(-45deg); }

  @media (max-width: 980px) {
    .burger { display: block; }
    .nav {
      position: fixed; inset: 72px 0 0 0; background: var(--bg);
      flex-direction: column; align-items: stretch; gap: 24px; padding: 16px var(--gutter) 32px;
      transform: translateY(-8px); opacity: 0; visibility: hidden; transition: opacity .2s, transform .2s, visibility .2s;
      overflow-y: auto;
    }
    .is-open .nav { transform: none; opacity: 1; visibility: visible; }
    .nav ul { flex-direction: column; }
    .nav ul a { padding: 16px 0; font-family: var(--display); font-stretch: 108%; font-size: 1.5rem; font-weight: 600; color: var(--ink); border-bottom: 1px solid var(--line); }
    .nav__cta { padding: 16px; font-size: 1.05rem; }
  }
</style>
